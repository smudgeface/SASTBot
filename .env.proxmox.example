# SASTBot — PULL-based deploy environment (Proxmox / manual Docker host).
#
# Copy to `.env` NEXT TO docker/compose/docker-compose.proxmox.yml on the deploy
# host and fill in the values. This file is a template: it contains placeholders
# only — never commit a filled-in copy (real .env files are gitignored).
#
#   docker compose -f docker/compose/docker-compose.proxmox.yml --env-file .env pull
#   docker compose -f docker/compose/docker-compose.proxmox.yml --env-file .env up -d
#
# See docs/DEPLOY_PROXMOX.md for the full runbook.

# =============================================================================
# Image source
# =============================================================================

# Registry + namespace prefix for the pre-built images. Ask the SASTBot
# maintainer for the exact value. Form: <registry-host>/<workspace>
# e.g. crg.apkg.io/your-workspace
SASTBOT_REGISTRY=crg.apkg.io/REPLACE_ME

# Image tag to run. `latest` tracks the newest published build. For a
# deterministic, repeatable deploy pin an immutable version, e.g. 0.16.1.
# Upgrading = change this, then `pull` + `up -d`.
SASTBOT_IMAGE_TAG=latest

# Host port the frontend (SPA + proxied API) is published on. Browse to
# http://<host>:<this-port>. Change if 80 is already in use on the host.
SASTBOT_HTTP_PORT=80

# =============================================================================
# Required secrets / config
# =============================================================================

# 32-byte base64 AES-256-GCM key that encrypts stored credentials. Generate ONCE:
#   openssl rand -base64 32
# Save it in your password manager. Changing it after credentials exist makes
# them unrecoverable. The example below is a PLACEHOLDER — regenerate.
MASTER_KEY=REPLACE_ME_WITH_OPENSSL_RAND_BASE64_32

# Postgres credentials for the bundled database container.
POSTGRES_USER=sastbot
POSTGRES_PASSWORD=REPLACE_ME_WITH_A_STRONG_PASSWORD
POSTGRES_DB=sastbot

# The exact origin the browser uses to reach SASTBot (scheme + host + port, no
# trailing slash). Must match what users type. A bare IP is fine — you do NOT
# need a domain name. Only gates cross-origin API calls (the bundled UI is
# same-origin), but set it correctly.
#   Hostname, port 80:  http://sastbot.internal.example
#   Hostname + port:    http://sastbot.internal.example:8080
#   IP address + port:  http://192.168.20.50:8080
#   IP address, port 80: http://192.168.20.50
#   Behind HTTPS proxy: https://sastbot.internal.example
APP_ORIGIN=http://REPLACE_ME

# Mark session cookies Secure (HTTPS-only). Keep `false` for an HTTP-only
# deploy. Set `true` ONLY once a TLS reverse proxy fronts the host — otherwise
# the browser silently drops the cookie and every refresh logs the user out.
SESSION_COOKIE_SECURE=false

# The app refuses to boot with SESSION_COOKIE_SECURE=false in production unless
# you explicitly acknowledge it here. `true` = "yes, this is a trusted internal
# HTTP-only deployment; I accept that session cookies travel in clear text."
# Once TLS fronts the host, set SESSION_COOKIE_SECURE=true and this back to false.
ALLOW_INSECURE_COOKIES=true

# =============================================================================
# Optional tuning (sensible defaults baked into the compose)
# =============================================================================

# LOG_LEVEL=info
# SCAN_WORKER_CONCURRENCY=2          # 1..4; how many scans run in parallel
# BACKUP_RETENTION_COUNT=10          # pre-deploy backups kept in the volume
# ALLOW_DEPLOY_WITHOUT_BACKUP=false  # set true ONLY to break a stuck deploy loop
