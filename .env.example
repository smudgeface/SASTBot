# SASTBot environment variables
#
# Copy this file to .env and customize. .env is gitignored.
# For production, set these in your deployment platform (e.g., Dokploy env vars),
# NEVER commit a real .env file.

# =============================================================================
# Required
# =============================================================================

# MASTER_KEY — 32-byte key (base64-encoded) used to AES-GCM encrypt credentials
# in Postgres. The backend refuses to start if this is missing, wrong length,
# or cannot decrypt the canary row.
#
# Generate a fresh one with:
#   python3 -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
#
# The example below is a PLACEHOLDER. Regenerate for any real deployment.
MASTER_KEY=NEEv6vwFIzi5U1VgMDWmCQB8AXOtjj9esL1E7BoiLf0=

# =============================================================================
# Database (compose sets sensible defaults)
# =============================================================================

POSTGRES_USER=sastbot
POSTGRES_PASSWORD=sastbot
POSTGRES_DB=sastbot
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Async SQLAlchemy URL. The backend composes this from the above, but you can
# override it for a non-compose setup.
# DATABASE_URL=postgresql+asyncpg://sastbot:sastbot@postgres:5432/sastbot

# =============================================================================
# Redis (compose sets this automatically)
# =============================================================================

REDIS_URL=redis://redis:6379/0

# =============================================================================
# Web / auth
# =============================================================================

# Origin allowed by CORS (React dev server). Production should use your deploy URL.
APP_ORIGIN=http://localhost:5173

# When true, session cookies are marked Secure (HTTPS only). Keep false locally,
# true in production.
SESSION_COOKIE_SECURE=false

# Optional: override the bootstrap admin email. If unset, defaults to
# admin@sastbot.local and a random password is printed to backend logs on first boot.
# BOOTSTRAP_ADMIN_EMAIL=admin@sastbot.local

# DEV-ONLY. When set, the bootstrap admin uses this exact password instead
# of a random one — convenient when iterating with `docker compose down -v`.
# HARD RULE: setting this with NODE_ENV=production is a boot-time config error.
# The backend refuses to start and prints a clear error message.
# Leave UNSET in production.
# BOOTSTRAP_ADMIN_PASSWORD=admin

# =============================================================================
# Auth rate-limiting
# =============================================================================

# Maximum login/logout attempts per IP per window before returning HTTP 429.
# Default: 10
# AUTH_RATE_LIMIT_MAX=10

# Length of the rate-limit window in milliseconds.
# Default: 60000 (1 minute)
# AUTH_RATE_LIMIT_WINDOW_MS=60000

# =============================================================================
# Claude Code CLI (M6 — LLM-mode SAST)
# =============================================================================
#
# No env vars here. LLM auth is configured in the SASTBot Settings page
# (Settings → LLM card: base URL, model, credential). The worker reads those
# values at scan time and injects them into the `claude -p` subprocess env.
# The model must speak Anthropic Messages format (LiteLLM's /anthropic
# passthrough is fine; pure OpenAI-format proxies are not).

# =============================================================================
# Worker concurrency
# =============================================================================

# Number of BullMQ scan jobs the worker processes in parallel.
# Default: 2 | Max: 4
# SCAN_WORKER_CONCURRENCY=2

# =============================================================================
# Logging / misc
# =============================================================================

LOG_LEVEL=info

# =============================================================================
# Artifact storage
# =============================================================================

# Directory where canonical SBOM + SARIF files are written, one per scan run.
# In compose this is a named volume (sastbot_artifacts) shared between backend
# and worker. Override only when running outside compose.
ARTIFACT_DIR=/var/lib/sastbot/artifacts
