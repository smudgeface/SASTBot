docker/compose/volumes/

# Logs
*.log
logs/

# Process crash dumps (e.g. a node/vitest core file)
core
core.*

# Generated types (kept committed for reviewability; uncomment to skip)
# frontend/src/api/schema.d.ts

# Runtime clone cache (future, worker repo clones)
.sastbot-clones/

# Personal / homelab-specific docs that shouldn't leak to work repo
docs/DEPLOY_HOMELAB.md
docs/DEPLOY_DOKPLOY_*.md

# Layered config files — contain secrets; YAML file must never be committed
backend/config.local.yaml
/etc/sastbot/

# Personal screenshots + original brief — local reference only, not part of the public repo
Screencaps/
SASTBot Initial Prompt.txt

# Claude Code: TRACK .claude/ (shared skills + settings.json) but keep per-user
# and machine-local state out of the repo. Any "*.local.md" file is local-only
# and never committed — use it for sensitive sidecars (e.g. a skill's prod
# connection target at .claude/skills/<name>/target.local.md, read via
# ${CLAUDE_SKILL_DIR}). Also covers root CLAUDE.local.md.
*.local.md
.claude/settings.local.json
.claude/*.local.json
.claude/*.png
.claude/*.lock
.claude/worktrees/

# Sensitive reference material — real customer/firmware audit findings, NOT part of
# this product's source. Contains plaintext credentials; must never enter the repo.
docs/Claude CRA Analysis Reference/

# Generated: user-manual content synced from docs/user-manual/ by
# frontend/scripts/sync-manual.mjs (runs on predev/prebuild). Canonical source
# of truth is docs/user-manual/. Do not edit or commit these copies.
frontend/src/manual/content/
frontend/src/manual/assets/*.png
