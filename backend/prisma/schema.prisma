// SASTBot Prisma schema — M5 issue identity refactor.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Org {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  users        User[]
  repos        Repo[]
  credentials  Credential[]
  scanRuns     ScanRun[]
  scanScopes   ScanScope[]
  appSettings  AppSettings[]
  sastFindings SastFinding[]
  jiraTickets  JiraTicket[]
  sastIssues   SastIssue[]
  scaIssues    ScaIssue[]

  @@map("orgs")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  orgId        String?   @map("org_id") @db.Uuid
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         String // "admin" | "user"
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(6)

  org      Org?      @relation(fields: [orgId], references: [id], onDelete: SetNull)
  sessions Session[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  userAgent String?  @map("user_agent")
  ipAddress String?  @map("ip_address")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Credential {
  id         String    @id @default(uuid()) @db.Uuid
  orgId      String?   @map("org_id") @db.Uuid
  kind       String
  name       String
  ciphertext Bytes
  nonce      Bytes
  tag        Bytes
  keyVersion Int       @default(1) @map("key_version")
  metadata   Json?
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz(6)
  createdBy  String?   @map("created_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  org          Org?          @relation(fields: [orgId], references: [id], onDelete: SetNull)
  reposUsing   Repo[]        @relation("RepoCredential")
  jiraSettings AppSettings[] @relation("JiraCredential")
  llmSettings  AppSettings[] @relation("LlmCredential")
  nvdSettings  AppSettings[] @relation("NvdCredential")

  @@map("credentials")
}

model ScanScope {
  id                  String    @id @default(uuid()) @db.Uuid
  orgId               String?   @map("org_id") @db.Uuid
  repoId              String    @map("repo_id") @db.Uuid
  path                String    @default("/")
  displayName         String?   @map("display_name")
  isActive            Boolean   @default(true) @map("is_active")
  lastScanRunId       String?   @map("last_scan_run_id") @db.Uuid
  lastScanCompletedAt DateTime? @map("last_scan_completed_at") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  org              Org?             @relation(fields: [orgId], references: [id], onDelete: SetNull)
  repo             Repo             @relation(fields: [repoId], references: [id], onDelete: Cascade)
  scanRuns         ScanRun[]
  sastFindings     SastFinding[]
  sastIssues       SastIssue[]
  scaIssues        ScaIssue[]
  scopeComponents  ScopeComponent[]

  @@unique([repoId, path], name: "uq_scan_scopes_repo_path")
  @@map("scan_scopes")
}

model Repo {
  id                  String    @id @default(uuid()) @db.Uuid
  orgId               String?   @map("org_id") @db.Uuid
  retainClone         Boolean   @default(false) @map("retain_clone")
  lastClonedAt        DateTime? @map("last_cloned_at") @db.Timestamptz(6)
  lastScheduledScanAt DateTime? @map("last_scheduled_scan_at") @db.Timestamptz(6)
  name                String
  url                 String
  protocol            String // "ssh" | "https"
  credentialId        String?   @map("credential_id") @db.Uuid
  defaultBranch       String    @default("main") @map("default_branch")
  scanPaths           Json      @default("[\"/\"]") @map("scan_paths")
  ignorePaths         Json      @default("[]") @map("ignore_paths")
  analysisTypes       Json      @default("[\"sca\"]") @map("analysis_types")
  scheduleCron        String?   @map("schedule_cron")
  sourceUrlTemplate   String?   @map("source_url_template")
  isActive            Boolean   @default(true) @map("is_active")
  // M6: SAST is performed by a single Claude Code CLI agentic pass which
  // also covers reachability + vendored-library detection. The four budgets
  // bound the SBOM augmentation, SBOM recheck, SAST detection, and SAST
  // recheck passes respectively. NULL → worker falls back to the compiled-in
  // default (200k / 50k / 300k / 50k). Set per-repo when a codebase is
  // unusually large or trivially small and the default wastes / exhausts tokens.
  llmSbomTokenBudget       Int?    @map("llm_sbom_token_budget")
  llmSbomRecheckTokenBudget Int?   @map("llm_sbom_recheck_token_budget")
  llmSastTokenBudget        Int?   @map("llm_sast_token_budget")
  llmRecheckTokenBudget     Int?   @map("llm_recheck_token_budget")
  // Effort level passed to `claude -p --effort`. Detection is open-ended
  // search and benefits from xhigh on Opus 4.7 (per docs guidance for
  // coding/agentic work). Recheck is narrow verification and is fine at
  // medium. Allowed values: low | medium | high | xhigh | max. xhigh is
  // Opus-only at the time of writing — Sonnet silently degrades it. The
  // CLI accepts the string verbatim so no model-side validation is needed.
  llmSastEffort         String  @default("xhigh")   @map("llm_sast_effort")
  llmRecheckEffort      String  @default("medium")  @map("llm_recheck_effort")
  // When false, the LLM SAST pass receives an empty SCA-hint input file
  // (skipping the reachability portion of Goal 2 in sast_detection.md).
  // Use for repos where the reachability signal hasn't proven worth the
  // additional output-token cost.
  reachabilityEnabled             Boolean @default(true) @map("reachability_enabled")
  // When reachability is enabled, controls whether components cdxgen 12.2+
  // flagged as dev-only (npm lockfile `dev: true`) are included in the LLM
  // hint set. Default true (include everything). Flip off on repos that
  // import a lot of npm dev tooling and you don't want reachability tokens
  // spent on them. npm-only signal — non-npm ecosystems are unaffected.
  // Caveat: cdxgen issue #3927 — `devOptional: true` lockfile entries miss
  // the dev marker, so a small fraction of dev-only deps still slip through.
  reachabilityIncludeDevDeps Boolean @default(false) @map("reachability_include_dev_deps")
  // M6p Stage 2: LLM SBOM augmentation pass.
  // firstPartyNamespaces — operator-curated name prefixes the LLM treats as
  //   first-party (e.g. ["GoSdkNet", "kApiNet", "LMI"]). Matched as string
  //   prefixes (case-insensitive) against component names. Default empty = no
  //   first-party filtering. Set per-repo since "first-party" is org-specific.
  firstPartyNamespaces String[] @default([]) @map("first_party_namespaces")
  // vendoredDirs — directories the LLM scans for vendored third-party C/C++
  //   (or other) libraries that cdxgen missed. Default covers the conventional
  //   locations. Override per repo when the tree uses a different layout.
  vendoredDirs  String[] @default(["extern/", "third-party/", "vendor/"]) @map("vendored_dirs")
  // llmSbomEffort — effort level for `claude -p --effort` in the augmentation
  //   pass. Default medium because it's classification work, not open-ended
  //   vulnerability search. Mirrors llmSastEffort/llmRecheckEffort from M6m.
  llmSbomEffort String  @default("medium") @map("llm_sbom_effort")
  // SBOM Component Recheck (Stage 2): effort level for the `llm_sbom_recheck`
  // phase that verifies previously-known components not surfaced in the current
  // augmentation run. Narrower task than detection (just confirming presence /
  // absence at a known path), so medium is a reasonable default.
  llmSbomRecheckEffort String @default("medium") @map("llm_sbom_recheck_effort")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  org        Org?        @relation(fields: [orgId], references: [id], onDelete: SetNull)
  credential Credential? @relation("RepoCredential", fields: [credentialId], references: [id], onDelete: SetNull)
  scanRuns   ScanRun[]
  scopes     ScanScope[]

  @@unique([orgId, url], name: "uq_repos_org_url")
  @@index([isActive, scheduleCron])
  @@map("repos")
}

model AppSettings {
  id                        String   @id @default(uuid()) @db.Uuid
  orgId                     String?  @unique @map("org_id") @db.Uuid
  jiraBaseUrl               String?  @map("jira_base_url")
  jiraEmail                 String?  @map("jira_email")
  jiraCredentialId          String?  @map("jira_credential_id") @db.Uuid
  llmBaseUrl                String?  @map("llm_base_url")
  llmApiFormat              String?  @map("llm_api_format")
  llmModel                  String?  @map("llm_model")
  llmCredentialId           String?  @map("llm_credential_id") @db.Uuid
  reachabilityMinSeverity   String   @default("high") @map("reachability_min_severity")
  updatedAt                 DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // NVD API key for querying the National Vulnerability Database. Without a
  // key, NVD allows 5 req / 30 sec; with one, 50 req / 30 sec. Leave null
  // until the operator adds a key via the admin UI.
  nvdCredentialId           String?  @map("nvd_credential_id") @db.Uuid

  org            Org?        @relation(fields: [orgId], references: [id], onDelete: SetNull)
  jiraCredential Credential? @relation("JiraCredential", fields: [jiraCredentialId], references: [id], onDelete: SetNull)
  llmCredential  Credential? @relation("LlmCredential", fields: [llmCredentialId], references: [id], onDelete: SetNull)
  nvdCredential  Credential? @relation("NvdCredential", fields: [nvdCredentialId], references: [id], onDelete: SetNull)

  @@map("app_settings")
}

model ScanRun {
  id                      String    @id @default(uuid()) @db.Uuid
  orgId                   String?   @map("org_id") @db.Uuid
  repoId                  String    @map("repo_id") @db.Uuid
  scopeId                 String    @map("scope_id") @db.Uuid
  status                  String // "pending" | "running" | "success" | "failed"
  triggeredBy             String    @map("triggered_by") // "user" | "api" | "schedule"
  triggeredByUserId       String?   @map("triggered_by_user_id") @db.Uuid
  startedAt               DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt              DateTime? @map("finished_at") @db.Timestamptz(6)
  error                   String?
  componentCount          Int       @default(0) @map("component_count")
  criticalCount           Int       @default(0) @map("critical_count")
  highCount               Int       @default(0) @map("high_count")
  mediumCount             Int       @default(0) @map("medium_count")
  lowCount                Int       @default(0) @map("low_count")
  warnings                Json      @default("[]")
  llmInputTokens          Int       @default(0) @map("llm_input_tokens")
  llmOutputTokens         Int       @default(0) @map("llm_output_tokens")
  llmRequestCount         Int       @default(0) @map("llm_request_count")
  sastFindingCount        Int       @default(0) @map("sast_finding_count")
  confirmedReachableCount Int       @default(0) @map("confirmed_reachable_count")
  // M6i: live-progress fields, updated by the worker as the scan moves
  // through phases. `currentPhase` is one of the canonical labels
  // (cloning / cdxgen / osv / eol / llm_detection / llm_recheck /
  // sca_summaries / finalizing). `phaseProgress` carries within-phase
  // counts when applicable: `{done: number, total: number, label?: string}`.
  // Both are null on terminal scans — the frontend reads them only while
  // status is "running".
  currentPhase            String?   @map("current_phase")
  phaseProgress           Json?     @map("phase_progress")
  // M9: discriminator for how this scan run's SBOM was produced.
  // "cdxgen" = standard pipeline (cdxgen + LLM augmentation).
  // "upload" = operator uploaded an external SBOM file (future Stream B work).
  // Stored as a plain string rather than a Prisma enum so adding new values
  // in the future does not require a multi-step enum migration.
  source                  String    @default("cdxgen") @map("source")
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  org               Org?               @relation(fields: [orgId], references: [id], onDelete: SetNull)
  repo              Repo               @relation(fields: [repoId], references: [id], onDelete: Cascade)
  scope             ScanScope          @relation(fields: [scopeId], references: [id], onDelete: Cascade)
  components        SbomComponent[]
  findings          ScanFinding[]
  sastFindings      SastFinding[]
  scanRunComponents ScanRunComponent[]

  @@index([scopeId, createdAt(sort: Desc)])
  @@index([repoId, createdAt(sort: Desc)])
  @@map("scan_runs")
}

model SbomComponent {
  id            String   @id @default(uuid()) @db.Uuid
  scanRunId     String   @map("scan_run_id") @db.Uuid
  name          String
  version       String?
  purl          String
  ecosystem     String?
  licenses      String[]
  componentType String   @default("library") @map("component_type")
  scope         String?
  // cdxgen 12.2+ emits `cdx:npm:package:development=true` as a property when
  // the npm lockfile entry has `dev: true`. npm-only signal today; other
  // ecosystems leave this false until cdxgen grows equivalent markers.
  // Caveat: cdxgen issue #3927 — `devOptional: true` lockfile entries miss
  // the marker, so a small fraction of dev-only packages will read as false.
  isDevOnly     Boolean  @default(false) @map("is_dev_only")
  manifestFile  String?  @map("manifest_file")  // e.g. "package-lock.json"
  // M6: how the component was discovered. "manifest" = cdxgen reading a
  // package.json / lockfile / similar; "vendored_inspection" = the LLM SAST
  // pass identified a checked-in vendored library by directory + content.
  discoveryMethod String? @default("manifest") @map("discovery_method")
  evidenceLine    Int?    @map("evidence_line")
  // Mirrors ScopeComponent.componentRoot — shallowest directory path that
  // exclusively belongs to this upstream library. Used as the dedup identity.
  componentRoot   String? @map("component_root")
  // Mirrors ScopeComponent.evidence — diagnostic {path, line?}[] list.
  evidence        Json    @default("[]") @map("evidence")
  // M6p Stage 2: set by the LLM augmentation pass on components it added or
  // kept with a rationale. Shape: {path, excerpt, llmReason}. Stored so the
  // Components tab can show a tooltip explaining why the component is there.
  llmEvidence     Json?   @map("llm_evidence")
  // CPE 2.3 string for the component when known (e.g. emitted by the LLM SBOM
  // augmentation pass). Used to query NVD by exact CPE rather than keyword
  // search, giving much more precise vuln results for C/C++ vendored libs.
  // Example: "cpe:2.3:a:zlib:zlib:1.2.6:*:*:*:*:*:*:*"
  cpe             String? @map("cpe")
  // M6q: full list of locations where this component is used. Each entry is
  // {path: string, line: number | null}. `evidence.occurrences[]` is the gold
  // source (repo-relative, with line numbers); falls back to
  // `evidence.identity[].methods[].value` (repo-relative after M6q CWD fix,
  // no line numbers). SrcFile properties are always redundant — skipped.
  // Default [] means "not yet extracted" and is populated on first write or
  // by the backfillSbomOccurrences worker boot hook.
  occurrences     Json    @default("[]") @map("occurrences")

  scanRun  ScanRun       @relation(fields: [scanRunId], references: [id], onDelete: Cascade)
  findings ScanFinding[]

  @@unique([scanRunId, purl], map: "sbom_components_scan_run_id_purl_unique")
  @@index([scanRunId])
  @@map("sbom_components")
}

model ScanFinding {
  id              String    @id @default(uuid()) @db.Uuid
  scanRunId       String    @map("scan_run_id") @db.Uuid
  componentId     String    @map("component_id") @db.Uuid
  issueId         String    @map("issue_id") @db.Uuid
  findingType     String    @default("cve") @map("finding_type")
  osvId           String    @map("osv_id")
  cveId           String?   @map("cve_id")
  severity        String    @default("unknown")
  cvssScore       Float?    @map("cvss_score")
  cvssVector      String?   @map("cvss_vector")
  summary         String?
  aliases         String[]
  activelyExploited Boolean @default(false) @map("actively_exploited")
  eolDate         DateTime? @map("eol_date") @db.Timestamptz(6)
  detailJson      Json?     @map("detail_json")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  scanRun   ScanRun       @relation(fields: [scanRunId], references: [id], onDelete: Cascade)
  component SbomComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)
  issue     ScaIssue      @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([scanRunId])
  @@map("scan_findings")
}

model SastFinding {
  id          String   @id @default(uuid()) @db.Uuid
  scanRunId   String   @map("scan_run_id") @db.Uuid
  scopeId     String   @map("scope_id") @db.Uuid
  orgId       String?  @map("org_id") @db.Uuid
  issueId     String   @map("issue_id") @db.Uuid
  fingerprint String
  ruleId      String   @map("rule_id")
  ruleName    String?  @map("rule_name")
  ruleMessage String?  @map("rule_message")
  cweIds      String[] @map("cwe_ids")
  severity    String   @default("info")
  filePath    String   @map("file_path")
  startLine   Int      @map("start_line")
  endLine     Int?     @map("end_line")
  snippet     String?
  detailJson  Json?    @map("detail_json")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  scanRun ScanRun   @relation(fields: [scanRunId], references: [id], onDelete: Cascade)
  scope   ScanScope @relation(fields: [scopeId], references: [id], onDelete: Cascade)
  org     Org?      @relation(fields: [orgId], references: [id], onDelete: SetNull)
  issue   SastIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@unique([scanRunId, fingerprint])
  @@index([fingerprint])
  @@index([scopeId, fingerprint])
  @@map("sast_findings")
}

model SastIssue {
  id                   String    @id @default(uuid()) @db.Uuid
  orgId                String?   @map("org_id") @db.Uuid
  scopeId              String    @map("scope_id") @db.Uuid
  fingerprint          String
  // Decisions
  triageStatus         String    @default("pending") @map("triage_status")
  // "pending" | "confirmed" | "false_positive" | "suppressed" | "error"
  triageConfidence     Float?    @map("triage_confidence")
  triageReasoning      String?   @map("triage_reasoning")
  triageModel          String?   @map("triage_model")
  triageInputTokens    Int?      @map("triage_input_tokens")
  triageOutputTokens   Int?      @map("triage_output_tokens")
  suppressedAt         DateTime? @map("suppressed_at") @db.Timestamptz(6)
  suppressedByUserId   String?   @map("suppressed_by_user_id") @db.Uuid
  suppressedReason     String?   @map("suppressed_reason")
  notes                String?
  jiraTicketId         String?   @map("jira_ticket_id") @db.Uuid
  // Denorm from latest detection
  latestRuleId         String    @map("latest_rule_id")
  latestRuleName       String?   @map("latest_rule_name")
  latestRuleMessage    String?   @map("latest_rule_message")
  latestLlmSummary     String?   @map("latest_llm_summary")
  latestSeverity       String    @default("info") @map("latest_severity")
  latestCweIds         String[]  @default([]) @map("latest_cwe_ids")
  latestFilePath       String    @map("latest_file_path")
  latestStartLine      Int       @map("latest_start_line")
  // Inclusive last line of the problem region. NULL on rows that pre-date
  // M6k (the worker-builds-snippet cutover) — frontend / SARIF treat NULL
  // as a single-line region.
  latestEndLine        Int?      @map("latest_end_line")
  latestSnippet        String?   @map("latest_snippet")
  // Lifecycle
  firstSeenAt          DateTime  @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  firstSeenScanRunId   String    @map("first_seen_scan_run_id") @db.Uuid
  lastSeenAt           DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  lastSeenScanRunId    String    @map("last_seen_scan_run_id") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  org        Org?        @relation(fields: [orgId], references: [id], onDelete: SetNull)
  scope      ScanScope   @relation(fields: [scopeId], references: [id], onDelete: Cascade)
  jiraTicket JiraTicket? @relation(fields: [jiraTicketId], references: [id], onDelete: SetNull)
  detections SastFinding[]

  @@unique([scopeId, fingerprint], name: "uq_sast_issues_scope_fingerprint")
  @@index([scopeId, triageStatus])
  @@index([scopeId, latestSeverity])
  @@index([jiraTicketId])
  @@map("sast_issues")
}

model ScaIssue {
  id                          String    @id @default(uuid()) @db.Uuid
  orgId                       String?   @map("org_id") @db.Uuid
  scopeId                     String    @map("scope_id") @db.Uuid
  packageName                 String    @map("package_name")
  osvId                       String    @map("osv_id")
  // Decisions
  dismissedStatus             String    @default("pending") @map("dismissed_status")
  // "pending" | "confirmed" | "planned" | "fixed" | "suppressed" | "false_positive" — unified with SastIssue.triageStatus
  dismissedAt                 DateTime? @map("dismissed_at") @db.Timestamptz(6)
  dismissedByUserId           String?   @map("dismissed_by_user_id") @db.Uuid
  dismissedReason             String?   @map("dismissed_reason")
  notes                       String?
  jiraTicketId                String?   @map("jira_ticket_id") @db.Uuid
  // Denorm from latest detection
  latestPackageVersion        String?   @map("latest_package_version")
  latestEcosystem             String?   @map("latest_ecosystem")
  latestComponentScope        String?   @map("latest_component_scope") // "required" | "optional"
  latestIsDevOnly             Boolean   @default(false) @map("latest_is_dev_only") // mirrors SbomComponent.isDevOnly from latest detection
  latestFindingType           String    @default("cve") @map("latest_finding_type")
  latestCveId                 String?   @map("latest_cve_id")
  latestSeverity              String    @default("unknown") @map("latest_severity")
  latestCvssScore             Float?    @map("latest_cvss_score")
  latestCvssVector            String?   @map("latest_cvss_vector")
  latestSummary               String?   @map("latest_summary")
  latestLlmSummary            String?   @map("latest_llm_summary")
  latestAliases               String[]  @default([]) @map("latest_aliases")
  latestActivelyExploited     Boolean   @default(false) @map("latest_actively_exploited")
  latestEolDate               DateTime? @map("latest_eol_date") @db.Timestamptz(6)
  latestHasFix                Boolean   @default(false) @map("latest_has_fix")
  // Origin: the manifest (e.g. package-lock.json) where this dep is declared.
  latestManifestFile          String?   @map("latest_manifest_file")
  latestManifestLine          Int?      @map("latest_manifest_line")
  latestManifestSnippet       String?   @map("latest_manifest_snippet")
  // Reachability (latest assessment; overwritten each scan the issue is detected in)
  confirmedReachable          Boolean   @default(false) @map("confirmed_reachable")
  reachableViaSastFingerprint String?   @map("reachable_via_sast_fingerprint")
  reachableReasoning          String?   @map("reachable_reasoning")
  reachableConfidence         Float?    @map("reachable_confidence")
  reachableCallSites          Json?     @map("reachable_call_sites")
  reachableAssessedAt         DateTime? @map("reachable_assessed_at") @db.Timestamptz(6)
  reachableModel              String?   @map("reachable_model")
  reachableAtScanRunId        String?   @map("reachable_at_scan_run_id") @db.Uuid
  // Provenance: which service produced this finding. "osv" for OSV.dev,
  // "nvd" for NVD CVE API (used for generic/C-C++ components where OSV
  // coverage is sparse). Kept as string so future sources can be added
  // without a migration. Re-uses osvId column for CVE IDs from NVD —
  // CVE-YYYY-NNNN IDs are globally unique so the unique constraint still holds.
  source                      String    @default("osv") @map("source")
  // Lifecycle
  firstSeenAt                 DateTime  @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  firstSeenScanRunId          String    @map("first_seen_scan_run_id") @db.Uuid
  lastSeenAt                  DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  lastSeenScanRunId           String    @map("last_seen_scan_run_id") @db.Uuid
  createdAt                   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  org        Org?        @relation(fields: [orgId], references: [id], onDelete: SetNull)
  scope      ScanScope   @relation(fields: [scopeId], references: [id], onDelete: Cascade)
  jiraTicket JiraTicket? @relation(fields: [jiraTicketId], references: [id], onDelete: SetNull)
  detections ScanFinding[]

  @@unique([scopeId, packageName, osvId], name: "uq_sca_issues_scope_pkg_osv")
  @@index([scopeId, latestSeverity])
  @@index([scopeId, dismissedStatus])
  @@index([jiraTicketId])
  @@map("sca_issues")
}

model JiraTicket {
  id             String    @id @default(uuid()) @db.Uuid
  orgId          String?   @map("org_id") @db.Uuid
  issueKey       String    @map("issue_key")
  issueId        String?   @map("issue_id")
  projectKey     String?   @map("project_key")
  projectName    String?   @map("project_name")
  summary        String?
  status         String?
  statusCategory String?   @map("status_category") // "new" | "indeterminate" | "done"
  resolution     String?   // raw resolution name e.g. "Done", "Won't Do", "Invalid"
  assigneeName   String?   @map("assignee_name")
  assigneeEmail  String?   @map("assignee_email")
  fixVersions    String[]  @default([]) @map("fix_versions")
  issueType      String?   @map("issue_type")
  url            String?
  resolvedAt     DateTime? @map("resolved_at") @db.Timestamptz(6)
  lastSyncedAt   DateTime? @map("last_synced_at") @db.Timestamptz(6)
  syncError      String?   @map("sync_error")
  linkedByUserId String?   @map("linked_by_user_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  org        Org?        @relation(fields: [orgId], references: [id], onDelete: SetNull)
  sastIssues SastIssue[]
  scaIssues  ScaIssue[]

  @@unique([orgId, issueKey], name: "uq_jira_tickets_org_key")
  @@index([orgId, statusCategory])
  @@map("jira_tickets")
}

model CveKnowledge {
  id                   String    @id @default(uuid()) @db.Uuid
  osvId                String    @unique @map("osv_id")
  cveId                String?   @map("cve_id")
  ecosystem            String
  packageName          String    @map("package_name")
  vulnerableFunctions  String[]  @map("vulnerable_functions")
  extractionMethod     String    @map("extraction_method")
  extractionConfidence Float     @map("extraction_confidence")
  extractionModel      String?   @map("extraction_model")
  extractionReasoning  String?   @map("extraction_reasoning")
  osvModifiedAt        DateTime? @map("osv_modified_at") @db.Timestamptz(6)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([ecosystem, packageName])
  @@map("cve_knowledge")
}

model Canary {
  id         String @id @default(uuid()) @db.Uuid
  ciphertext Bytes
  nonce      Bytes
  tag        Bytes
  keyVersion Int    @default(1) @map("key_version")

  @@map("encryption_canary")
}

// ---------------------------------------------------------------------------
// SBOM Component Recheck — Stage 1 (scope-level component state)
// ---------------------------------------------------------------------------
// Mirrors the proven sast_issues / sca_issues model: each scan contributes
// evidence to a cumulative, durable scope-level record. Per-scan-run view
// is now a join table (scan_run_components) rather than the primary container.
// See docs/SBOM_COMPONENT_RECHECK_PLAN.md for the full architectural rationale.

model ScopeComponent {
  id              String    @id @default(uuid()) @db.Uuid
  scopeId         String    @map("scope_id") @db.Uuid
  orgId           String?   @map("org_id") @db.Uuid

  name            String
  version         String?
  purl            String
  ecosystem       String?
  licenses        String[]
  componentType   String    @default("library") @map("component_type")
  scope           String?
  isDevOnly       Boolean   @default(false) @map("is_dev_only")
  manifestFile    String?   @map("manifest_file")
  discoveryMethod String?   @default("manifest") @map("discovery_method")
  evidenceLine    Int?      @map("evidence_line")
  // Stable identity for vendored components: the shallowest directory path
  // that exclusively belongs to this upstream library (e.g. "extern/Xenomai",
  // or "extern/Nerian/libnvshared" when sibling libs share a parent). Used
  // as the primary key in the deterministic match chain — robust against
  // the LLM picking different evidence_files for the same library across scans.
  // Null for manifest-tracked components (npm/pypi/etc.) where purl is identity.
  componentRoot   String?   @map("component_root")
  // Identity-shaped evidence: WHERE the analyzer concluded this component
  // is present in the source. Small (~1 entry). Two shapes:
  //   - Manifest-tracked package: {path: manifest_file, line: <lockfile
  //     entry line>, snippet: <±3 lines>}.
  //   - Vendored library: {path: component_root}. No line, no snippet.
  // The user-facing detail panel renders these with a code preview when
  // snippet is present. Operator-curated rows (source='manual_override')
  // are never overwritten by the persist flow.
  evidence        Json      @default("[]") @map("evidence")
  // Usage locations: WHERE the component is referenced from. Long list of
  // {path, line?} pulled from sbom_components.occurrences at scan-write
  // time. Clickable file:line links — no snippets. The scan-page Components
  // tab renders the same list straight from sbom_components.occurrences.
  usage           Json      @default("[]") @map("usage")
  // Deprecated: legacy single-file evidence path. Kept for backwards-compat
  // reads against existing rows; new writes populate `evidence` instead.
  evidencePath    String?   @map("evidence_path")
  llmEvidence     Json?     @map("llm_evidence")
  cpe             String?

  // M9 Stream C: fields promoted from sbom_components so the scope-level
  // curated SBOM can be built entirely from scope_components (F1/F6 fix).
  // Populated on every scan merge pass; always overwritten (not COALESCE'd)
  // because they represent "what the latest scan observed", not an operator
  // choice. NULL on rows that pre-date this migration and have not been
  // re-scanned since.
  latestLicenses        String[]  @default([]) @map("latest_licenses")
  latestCpe             String?   @map("latest_cpe")
  latestComponentType   String?   @map("latest_component_type")
  latestDiscoveryMethod String?   @map("latest_discovery_method")
  latestLlmEvidence     Json?     @map("latest_llm_evidence")

  // Lifecycle — mirrors SastIssue / ScaIssue pattern
  source          String    @default("scan")
  // "active" | "removed" | "manual_override"
  dismissedStatus String    @default("active") @map("dismissed_status")
  dismissedReason String?   @map("dismissed_reason")
  dismissedAt     DateTime? @map("dismissed_at") @db.Timestamptz(6)

  firstSeenScanRunId String?   @map("first_seen_scan_run_id") @db.Uuid
  lastSeenScanRunId  String?   @map("last_seen_scan_run_id") @db.Uuid
  lastSeenAt         DateTime? @map("last_seen_at") @db.Timestamptz(6)

  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  scope_      ScanScope          @relation(fields: [scopeId], references: [id], onDelete: Cascade)
  scanRunLinks ScanRunComponent[]

  @@unique([scopeId, name, version, purl], name: "uq_scope_components_scope_name_ver_purl")
  @@index([scopeId, dismissedStatus])
  @@map("scope_components")
}

model ScanRunComponent {
  scanRunId        String @map("scan_run_id") @db.Uuid
  scopeComponentId String @map("scope_component_id") @db.Uuid
  // "manifest" | "llm_augmentation" | "recheck_recovery"
  discoveryMethod  String @map("discovery_method")

  scanRun        ScanRun        @relation(fields: [scanRunId], references: [id], onDelete: Cascade)
  scopeComponent ScopeComponent @relation(fields: [scopeComponentId], references: [id], onDelete: Cascade)

  @@id([scanRunId, scopeComponentId])
  @@map("scan_run_components")
}
